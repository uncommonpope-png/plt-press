# Jarvis Bridge — Environment Variables
# Copy this file to .env and fill in the values you want to use.
# Lines starting with # are comments.

# ── Bridge Server ─────────────────────────────────────────────
PORT=3001

# ── Kernel Connection ─────────────────────────────────────────
KERNEL_HOST=127.0.0.1
KERNEL_PORT=9002

# ── LLM (optional — enables natural language mode) ────────────
# Leave blank to run in rule-based mode (no API key required).
OPENAI_API_KEY=
# Custom OpenAI-compatible base URL (e.g. for local LLMs via Ollama/LM Studio):
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name:
OPENAI_MODEL=gpt-4o-mini

# ── Web Search (optional) ─────────────────────────────────────
# Serper.dev API key for Google Search results.
# Without this, DuckDuckGo instant answers are used (no key required).
SERPER_API_KEY=

# ── Safety Limits ─────────────────────────────────────────────
FETCH_TIMEOUT_MS=8000
MAX_CONTENT_BYTES=32768
